{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "player-view",
    "map-editor"
  ],
  "remote": {
    "urls": [
      "http://localhost:*/**"
    ]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "notification:default",
    "allow-custom-commands"
  ]
}
